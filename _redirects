# Redirecionamentos Canônicos 301 (Antigas rotas -> Novas rotas canônicas)
/admin.html     /app            301
/admin          /app            301
/portal.html    /status         301
/portal         /status         301
/tracking       /status         301

# Rewrites Transparentes 200 (Execução das páginas limpas)
/app            /admin.html     200
/status         /portal.html    200
/os/:id         /portal.html    200
/t/:token       /portal.html    200
